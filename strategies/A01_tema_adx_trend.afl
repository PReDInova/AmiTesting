// ===========================================
// A01 - TEMA + ADX Trend Filter
// ===========================================
//
// Trend-following strategy on native 1-minute data. Uses TEMA crossover signals confirmed by ADX trend
// strength. Only enters trades when ADX indicates a strong trend is present
// and directional indicators confirm the direction.
//
// Entry Long:  TEMA crosses above Close AND ADX > threshold AND +DI > -DI
// Entry Short: Close crosses above TEMA AND ADX > threshold AND -DI > +DI
//
// Exit: StdDev-based symmetric stop loss and profit target
//
// Targets NQ and GC futures on native 1-minute data.

// ---- Strategy Parameters ----
// ---- Symbol filter (NQ and GC futures) ----
isTargetSymbol = Name() == "NQ" OR Name() == "GC";

temaLength   = Param("TEMA Length", 8, 3, 50, 1);
adxPer       = Param("ADX Period", 14, 5, 50, 1);
adxThreshold = Param("ADX Threshold", 15, 5, 40, 1);
sdBars       = Param("StdDev Lookback (bars)", 30, 5, 200, 1);
sdMult       = Param("StdDev Multiplier", 1.0, 0.1, 5.0, 0.1);
profitMult   = Param("Profit Target Mult", 1.0, 0.5, 3.0, 0.1);


// ---- TEMA Indicator (inline, using AmiBroker built-in EMA) ----
ema1 = EMA(Close, temaLength);
ema2 = EMA(ema1, temaLength);
ema3 = EMA(ema2, temaLength);
temas = 3 * ema1 - 3 * ema2 + ema3;


// ---- StdDev Exit Indicator (from indicator library) ----
sdLookback   = sdBars;
sdMultiplier = sdMult;
sdSource     = Close;
// ---- StdDev Exit Levels (inline) ----
exitStdDev = StDev(Close, sdLookback);
exitDistance = sdMultiplier * exitStdDev;

// ---- ADX Calculation (inline to avoid Plot() calls from adx.afl) ----
adxTR      = Max(High - Low, Max(abs(High - Ref(Close, -1)), abs(Low - Ref(Close, -1))));
adxATR     = Wilders(adxTR, adxPer);
adxPlusDM  = IIf(High - Ref(High, -1) > Ref(Low, -1) - Low AND High - Ref(High, -1) > 0, High - Ref(High, -1), 0);
adxMinusDM = IIf(Ref(Low, -1) - Low > High - Ref(High, -1) AND Ref(Low, -1) - Low > 0, Ref(Low, -1) - Low, 0);
plusDI      = 100 * Wilders(adxPlusDM, adxPer) / adxATR;
minusDI     = 100 * Wilders(adxMinusDM, adxPer) / adxATR;
DX          = 100 * abs(plusDI - minusDI) / (plusDI + minusDI);
ADXvalue    = Wilders(DX, adxPer);


// ---- Entry Signals (filtered by session and ADX trend) ----
trendConfirmed = ADXvalue > adxThreshold;

buySignal   = Cross(temas, Close) AND trendConfirmed AND plusDI > minusDI AND isTargetSymbol;
shortSignal = Cross(Close, temas) AND trendConfirmed AND minusDI > plusDI AND isTargetSymbol;

tema1m     = temas;
exitDist1m = exitDistance;
adx1m      = ADXvalue;
pdi1m      = plusDI;
mdi1m      = minusDI;


// ---- Assign Entry/Exit Signals ----
Buy   = buySignal;
Sell  = 0;   // exits handled by ApplyStop
Short = shortSignal;
Cover = 0;   // exits handled by ApplyStop

// ---- StdDev-based stop loss and profit target ----
ApplyStop(stopTypeLoss, stopModePoint, exitDist1m);
ApplyStop(stopTypeProfit, stopModePoint, exitDist1m * profitMult);

// ---- Position sizing: 1 contract ----
SetPositionSize(1, spsShares);

// ---- Remove duplicate signals ----
Buy   = ExRem(Buy, Short);
Short = ExRem(Short, Buy);

// ---- Visualization ----
Plot(Close, "Price", colorDefault, styleCandle);
Plot(tema1m, "TEMA(" + NumToStr(temaLength, 1.0) + ")", colorAqua, styleLine | styleThick);

PlotShapes(Buy * shapeUpArrow, colorGreen, 0, Low, -12);
PlotShapes(Short * shapeDownArrow, colorRed, 0, High, -12);

Title = Name() + " | A01 TEMA+ADX Trend | TEMA(" + NumToStr(temaLength, 1.0) +
        ") ADX(" + NumToStr(adxPer, 1.0) + ")>" + NumToStr(adxThreshold, 1.0) +
        " | ADX=" + NumToStr(adx1m, 1.1) +
        " +DI=" + NumToStr(pdi1m, 1.1) + " -DI=" + NumToStr(mdi1m, 1.1) +
        " | SD(" + NumToStr(sdBars, 1.0) + ")x" + NumToStr(sdMult, 1.1) +
        " ProfM=" + NumToStr(profitMult, 1.1) +
        " = " + NumToStr(exitDist1m, 1.4) + " pts";
