// ===========================================
// A03 - Consolidation Zone Breakout
// ===========================================
//
// Breakout strategy on native 1-minute data. Detects consolidation zones using TEMA derivative
// flatness and price range tightness, then trades the breakout when
// price exits the zone with momentum.
//
// Entry Long:  czBreakoutUp signal (price breaks above consolidation zone)
// Entry Short: czBreakoutDown signal (price breaks below consolidation zone)
//
// Exit: StdDev-based symmetric stops with wider multiplier (1.5)
//       to give breakout trades room to develop
//
// Targets NQ and GC futures on native 1-minute data.

// ---- Strategy Parameters ----
// ---- Symbol filter (NQ and GC futures) ----
isTargetSymbol = Name() == "NQ" OR Name() == "GC";

czTemaLength    = Param("CZ TEMA Length", 21, 5, 50, 1);
czFlatThreshold = Param("CZ Flat Threshold", 0.50, 0.05, 2.0, 0.05);
czMaxRangeTicks = Param("CZ Max Range (ticks)", 80, 20, 200, 5);
czMinConsolBars = Param("CZ Min Consol Bars", 5, 1, 30, 1);
sdBars          = Param("StdDev Lookback (bars)", 30, 5, 200, 1);
sdMult          = Param("StdDev Multiplier", 1.5, 0.1, 5.0, 0.1);
profitMult      = Param("Profit Target Mult", 1.0, 0.5, 3.0, 0.1);


// ---- Consolidation Zone Indicator (from indicator library) ----
#include_once "C:\Users\prestondinova\Documents\AmiTesting\indicators\consolidation_zones.afl"

// ---- StdDev Exit Levels (inline) ----
exitStdDev = StDev(Close, sdBars);
exitDistance = sdMult * exitStdDev;


// ---- Entry Signals (filtered by session) ----
buySignal   = czBreakoutUp AND isTargetSymbol;
shortSignal = czBreakoutDown AND isTargetSymbol;

exitDist1m    = exitDistance;
czHigh1m      = czHigh;
czLow1m       = czLow;
czMid1m       = czMid;
isConsol1m    = isConsolidating;
czStrength1m  = czStrength;


// ---- Assign Entry/Exit Signals ----
Buy   = buySignal;
Sell  = 0;   // exits handled by ApplyStop
Short = shortSignal;
Cover = 0;   // exits handled by ApplyStop

// ---- StdDev-based stop loss and profit target ----
ApplyStop(stopTypeLoss, stopModePoint, exitDist1m);
ApplyStop(stopTypeProfit, stopModePoint, exitDist1m * profitMult);

// ---- Position sizing: 1 contract ----
SetPositionSize(1, spsShares);

// ---- Remove duplicate signals ----
Buy   = ExRem(Buy, Short);
Short = ExRem(Short, Buy);

// ---- Visualization ----
Plot(Close, "Price", colorDefault, styleCandle);

// Plot consolidation zone boundaries
Plot(IIf(NOT IsNull(czHigh1m), czHigh1m, Null), "CZ High", colorOrange, styleDashed | styleNoRescale);
Plot(IIf(NOT IsNull(czLow1m), czLow1m, Null), "CZ Low", colorOrange, styleDashed | styleNoRescale);
Plot(IIf(NOT IsNull(czMid1m), czMid1m, Null), "CZ Mid", colorGrey50, styleDots | styleNoRescale);

// Shade consolidation zone
PlotOHLC(czHigh1m, czHigh1m, czLow1m, czLow1m, "", ColorBlend(colorOrange, colorWhite, 0.85), styleCloud | styleNoRescale);

PlotShapes(Buy * shapeUpArrow, colorGreen, 0, Low, -12);
PlotShapes(Short * shapeDownArrow, colorRed, 0, High, -12);

Title = Name() + " | A03 CZ Breakout | CZ(" + NumToStr(czTemaLength, 1.0) +
        ") Flat<" + NumToStr(czFlatThreshold, 1.2) +
        " Range<" + NumToStr(czMaxRangeTicks, 1.0) + "t" +
        " Min=" + NumToStr(czMinConsolBars, 1.0) + "bars" +
        " | Str=" + NumToStr(czStrength1m, 1.0) +
        " | SD(" + NumToStr(sdBars, 1.0) + ")x" + NumToStr(sdMult, 1.1) +
        " ProfM=" + NumToStr(profitMult, 1.1) +
        " = " + NumToStr(exitDist1m, 1.4) + " pts";
