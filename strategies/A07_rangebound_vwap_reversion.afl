// ===========================================
// A07 - Range-Bound VWAP Mean Reversion
// ===========================================
//
// Mean-reversion strategy that trades VWAP band bounces during
// low-volatility (range-bound) conditions on 1-minute data.
//
// Entry Long:  Price near VWAP lower band AND volatility contracting
// Entry Short: Price near VWAP upper band AND volatility contracting
//
// Exit: StdDev-based stop loss and profit target (tighter for range trading)
//
// Targets NQ and GC futures on native 1-minute data.

// ---- Strategy Parameters ----
// ---- Symbol filter (NQ and GC futures) ----
isTargetSymbol = Name() == "NQ" OR Name() == "GC";

sdBars          = Param("StdDev Lookback (bars)", 30, 5, 200, 1);
sdMult          = Param("SD Multiplier", 0.75, 0.1, 5.0, 0.1);
profitMult      = Param("Profit Target Mult", 1.0, 0.5, 3.0, 0.1);
rangePeriod     = Param("Range Period", 10, 5, 50, 1);
rangeATRmult    = Param("Range ATR Mult", 10, 2, 20, 1);


// ---- VWAP Clouds Indicator ----
sessionResetTime = 93000;  // Reset VWAP at US market open (9:30 AM EST)
vwStdev1 = 1;
vwStdev2 = 2;
vwStdev3 = 3;
#include_once "C:\Users\prestondinova\Documents\AmiTesting\indicators\vwap_clouds.afl"

// ---- Inline Range-Bound Detection (1-min) ----
rangeHigh = HHV(H, rangePeriod);
rangeLow  = LLV(L, rangePeriod);
rangeWidth = rangeHigh - rangeLow;
atrValue = ATR(14);
isRangeBound = rangeWidth < atrValue * rangeATRmult;

// ---- StdDev Exit Levels (inline) ----
exitStdDev = StDev(Close, sdBars);
exitDistance = sdMult * exitStdDev;

vwap1m         = VWAP;
rangeHigh1m    = rangeHigh;
rangeLow1m     = rangeLow;
exitDist1m     = exitDistance;


// ---- Mean Reversion Entry Signals ----
// Long:  range-bound + price below VWAP lower 1-sigma band -> mean revert up
// Short: range-bound + price above VWAP upper 1-sigma band -> mean revert down
buySignal   = isRangeBound AND Close < s1 AND isTargetSymbol;
shortSignal = isRangeBound AND Close > r1 AND isTargetSymbol;


// ---- Entry signals ----
Buy   = buySignal;
Sell  = 0;   // exits handled by ApplyStop
Short = shortSignal;
Cover = 0;   // exits handled by ApplyStop

// ---- StdDev-based stop loss and profit target ----
ApplyStop(stopTypeLoss, stopModePoint, exitDist1m);
ApplyStop(stopTypeProfit, stopModePoint, exitDist1m * profitMult);

// ---- Position sizing: 1 contract ----
SetPositionSize(1, spsShares);

// ---- Remove duplicate signals ----
Buy   = ExRem(Buy, Short);
Short = ExRem(Short, Buy);

// ---- Visualization ----
Plot(Close, "Price", colorDefault, styleCandle);
Plot(vwap1m, "VWAP", colorYellow, styleLine | styleThick);
Plot(rangeHigh1m, "Range High", colorLightGrey, styleDashed);
Plot(rangeLow1m, "Range Low", colorLightGrey, styleDashed);

PlotShapes(Buy * shapeUpArrow, colorGreen, 0, Low, -12);
PlotShapes(Short * shapeDownArrow, colorRed, 0, High, -12);

Title = Name() + " | A07 Range-Bound VWAP Reversion" +
        " | SD(" + NumToStr(sdBars, 1.0) + ")x" + NumToStr(sdMult, 1.1) +
        " ProfM=" + NumToStr(profitMult, 1.1) +
        " = " + NumToStr(exitDist1m, 1.4) + " pts" +
        " | RangeBound=" + WriteIf(isRangeBound, "YES", "no");
