// ===========================================
// B04 - Stochastic Reversal Trading
// ===========================================
//
// Reversal strategy using Stochastic oscillator crossovers on
// 1-minute data. Enters when %K crosses %D in oversold/overbought
// zones. Uses manually calculated Stochastic to avoid AFL variable
// name conflicts.
//
// Entry Long:  %K crosses above %D AND %K in oversold zone
// Entry Short: %D crosses above %K AND %K in overbought zone
//
// Exit: StdDev-based symmetric stop loss and profit target
//
// Targets NQ and GC futures on native 1-minute data.

// ---- Strategy Parameters ----
isTargetSymbol = Name() == "NQ" OR Name() == "GC";

stochKper       = Param("Stoch %K Period", 9, 5, 21, 1);
stochDper       = Param("Stoch %D Period", 3, 2, 7, 1);
stochSmooth     = Param("Stoch Smoothing", 3, 1, 7, 1);
stochOB         = Param("Stoch Overbought", 60, 50, 90, 5);
stochOS         = Param("Stoch Oversold", 40, 10, 50, 5);
exitSDbars      = Param("StdDev Lookback (bars)", 30, 5, 200, 1);
exitSDmult      = Param("StdDev Multiplier", 1.0, 0.1, 5.0, 0.1);
profitMult      = Param("Profit Target Mult", 1.0, 0.5, 3.0, 0.1);


// ---- Stochastic Oscillator (manual calculation) ----
lowestLow = LLV(Low, stochKper);
highestHigh = HHV(High, stochKper);
rawK = IIf(highestHigh - lowestLow > 0, (Close - lowestLow) / (highestHigh - lowestLow) * 100, 50);
pctK = MA(rawK, stochSmooth);
pctD = MA(pctK, stochDper);

// ---- StdDev Exit Levels ----
exitStdDev = StDev(Close, exitSDbars);
exitDist = exitSDmult * exitStdDev;


// ---- Entry Signals ----
buySignal   = Cross(pctK, pctD) AND pctK < stochOS AND isTargetSymbol;
shortSignal = Cross(pctD, pctK) AND pctK > stochOB AND isTargetSymbol;


// ---- Assign Entry/Exit Signals ----
Buy   = buySignal;
Sell  = 0;   // exits handled by ApplyStop
Short = shortSignal;
Cover = 0;   // exits handled by ApplyStop

// ---- StdDev-based stop loss and profit target ----
ApplyStop(stopTypeLoss, stopModePoint, exitDist);
ApplyStop(stopTypeProfit, stopModePoint, exitDist * profitMult);

// ---- Position sizing: 1 contract ----
SetPositionSize(1, spsShares);

// ---- Remove duplicate signals ----
Buy   = ExRem(Buy, Short);
Short = ExRem(Short, Buy);

// ---- Visualization ----
Plot(Close, "Price", colorDefault, styleCandle);

PlotShapes(Buy * shapeUpArrow, colorGreen, 0, Low, -12);
PlotShapes(Short * shapeDownArrow, colorRed, 0, High, -12);

Title = Name() + " | B04 Stochastic Reversal | Stoch(" + NumToStr(stochKper, 1.0) +
        "," + NumToStr(stochDper, 1.0) + "," + NumToStr(stochSmooth, 1.0) +
        ") OB=" + NumToStr(stochOB, 1.0) + " OS=" + NumToStr(stochOS, 1.0) +
        " | %K=" + NumToStr(pctK, 1.1) + " %D=" + NumToStr(pctD, 1.1) +
        " | SD(" + NumToStr(exitSDbars, 1.0) + ")x" + NumToStr(exitSDmult, 1.1) +
        " = " + NumToStr(exitDist, 1.4) + " pts";
