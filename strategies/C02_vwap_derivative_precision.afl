// ===========================================
// C02 - VWAP Bands + Derivative Peaks (Precision Reversal)
// ===========================================
//
// Precision mean-reversion strategy on native 1-minute data. Enters reversal trades only when
// two independent conditions align:
//
// 1. Price has reached a VWAP standard deviation band (overextended)
// 2. TEMA derivative crosses zero (momentum shifting back toward mean)
//
// This dual confirmation reduces whipsaw entries that occur when
// trading VWAP bands alone, and avoids premature derivative signals
// that fire before price is at an extreme level.
//
// Entry Long:  Close below VWAP lower band AND firstDeriv crosses above 0
//              (price overextended down AND momentum turning bullish)
// Entry Short: Close above VWAP upper band AND firstDeriv crosses below 0
//              (price overextended up AND momentum turning bearish)
//
// Exit: StdDev-based symmetric stop loss and profit target
//
// Targets NQ and GC futures on native 1-minute data.

// ---- Strategy Parameters ----
// ---- Symbol filter (NQ and GC futures) ----
isTargetSymbol = Name() == "NQ" OR Name() == "GC";

temaLength    = Param("TEMA Length", 8, 3, 50, 1);
lookback      = Param("Deriv Lookback", 3, 2, 21, 1);
minSeparation = Param("Min Separation", 3, 1, 30, 1);
entryBand     = Param("VWAP Entry Band", 1, 1, 2, 1);
sdBars        = Param("StdDev Lookback (bars)", 30, 5, 200, 1);
sdMult        = Param("StdDev Multiplier", 1.0, 0.1, 5.0, 0.1);
profitMult    = Param("Profit Target Mult", 1.0, 0.5, 3.0, 0.1);


// ---- VWAP Clouds Indicator (from indicator library) ----
sessionResetTime = 93000;  // Reset VWAP at US market open (9:30 AM EST)
vwStdev1 = 1;
vwStdev2 = 2;
vwStdev3 = 3;
#include_once "C:\Users\prestondinova\Documents\AmiTesting\indicators\vwap_clouds.afl"

// ---- TEMA Indicator (inline, using AmiBroker built-in EMA) ----
ema1 = EMA(Close, temaLength);
ema2 = EMA(ema1, temaLength);
ema3 = EMA(ema2, temaLength);
temas = 3 * ema1 - 3 * ema2 + ema3;


// ---- Derivative Calculation (inline) ----
firstDeriv  = (temas - Ref(temas, -lookback)) / lookback;
secondDeriv = firstDeriv - Ref(firstDeriv, -lookback);

// ---- Peak/Trough Detection ----
slopeChangePosToNeg = Ref(firstDeriv, -1) > 0 AND firstDeriv <= 0;
slopeChangeNegToPos = Ref(firstDeriv, -1) < 0 AND firstDeriv >= 0;
isPeak   = slopeChangePosToNeg AND (secondDeriv < 0);
isTrough = slopeChangeNegToPos AND (secondDeriv > 0);

// ---- Min-separation filter ----
validPeak   = isPeak AND BarsSince(Ref(isPeak, -1)) >= minSeparation AND BarsSince(Ref(isTrough, -1)) >= minSeparation;
validTrough = isTrough AND BarsSince(Ref(isTrough, -1)) >= minSeparation AND BarsSince(Ref(isPeak, -1)) >= minSeparation;

// ---- Peak/Trough levels ----
peakLevel = ValueWhen(validPeak, temas);
troughLevel = ValueWhen(validTrough, temas);


// ---- StdDev Exit Levels (inline) ----
exitStdDev = StDev(Close, sdBars);
exitDistance = sdMult * exitStdDev;

// ---- Select VWAP Entry Bands ----
// entryBand=1 uses 1-sigma bands (s1/r1), entryBand=2 uses 2-sigma bands (s2/r2)
entryLower = IIf(entryBand == 1, s1, s2);
entryUpper = IIf(entryBand == 1, r1, r2);


// ---- Entry Signals (VWAP band extreme + derivative zero-cross) ----
// Long:  price below lower VWAP band AND derivative crosses zero upward
// Short: price above upper VWAP band AND derivative crosses zero downward
buySignal   = Close < entryLower AND Cross(firstDeriv, 0) AND isTargetSymbol;
shortSignal = Close > entryUpper AND Cross(0, firstDeriv) AND isTargetSymbol;

tema1m       = temas;
vwap1m       = VWAP;
entryLow1m   = entryLower;
entryUp1m    = entryUpper;
exitDist1m   = exitDistance;
vPeak1m      = validPeak;
vTrough1m    = validTrough;
firstD1m     = firstDeriv;


// ---- Assign Entry/Exit Signals ----
Buy   = buySignal;
Sell  = 0;   // exits handled by ApplyStop
Short = shortSignal;
Cover = 0;   // exits handled by ApplyStop

// ---- StdDev-based stop loss and profit target ----
ApplyStop(stopTypeLoss, stopModePoint, exitDist1m);
ApplyStop(stopTypeProfit, stopModePoint, exitDist1m * profitMult);

// ---- Position sizing: 1 contract ----
SetPositionSize(1, spsShares);

// ---- Remove duplicate signals ----
Buy   = ExRem(Buy, Short);
Short = ExRem(Short, Buy);

// ---- Visualization ----
Plot(Close, "Price", colorDefault, styleCandle);
Plot(tema1m, "TEMA(" + NumToStr(temaLength, 1.0) + ")", colorAqua, styleLine | styleThick);
Plot(vwap1m, "VWAP", colorYellow, styleLine | styleThick);
Plot(entryLow1m, "Entry Lower", colorAqua, styleDashed | styleNoRescale);
Plot(entryUp1m, "Entry Upper", colorAqua, styleDashed | styleNoRescale);

PlotShapes(Buy * shapeUpArrow, colorGreen, 0, Low, -12);
PlotShapes(Short * shapeDownArrow, colorRed, 0, High, -12);

// Mark derivative turning points
PlotShapes(vPeak1m * shapeSmallDownTriangle, colorOrange, 0, High, -20);
PlotShapes(vTrough1m * shapeSmallUpTriangle, colorLime, 0, Low, -20);

Title = Name() + " | C02 VWAP+Derivative Precision | TEMA(" + NumToStr(temaLength, 1.0) +
        ") Deriv(" + NumToStr(lookback, 1.0) + "/" + NumToStr(minSeparation, 1.0) + ")" +
        " Band=" + NumToStr(entryBand, 1.0) + "s" +
        " | 1stDeriv=" + NumToStr(firstD1m, 1.4) +
        " | SD x" + NumToStr(sdMult, 1.1) +
        " = " + NumToStr(exitDist1m, 1.4) + " pts";
